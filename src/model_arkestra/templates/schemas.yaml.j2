# ── Schema Registry ────────────────────────────────────────────────
# Admin UI uses this to render editable fields in the config panel.
# Keys resolve via: schemas["model-args"][engine_name]

model-args:

  llama-cpp:
    name:
      type: string
    repo:
      type: string
      default: hf
      options: [hf, lcl]
    model:
      type: string
    ctx-size:
      type: integer
    temp:
      type: float
      minimum: 0.0
      maximum: 2.0
    top-p:
      type: float
      minimum: 0.0
      maximum: 1.0
    top-k:
      type: integer
      minimum: 1
    min-p:
      type: float
      minimum: 0.0
      maximum: 1.0
    batch-size:
      type: integer
      minimum: 1
    ngl:
      type: integer
    presence-penalty:
      type: float
      step: 0.1
    repeat-penalty:
      type: float
      step: 0.1
    max-tokens:
      type: integer
      minimum: 1
    flash-attn:
      type: boolean
    chat-template-kwargs:
      type: string
