# ═══════════════════════════════════════════════════════════
# sources.yaml — Binary & image download sources (optional)
# ═══════════════════════════════════════════════════════════
#
# Define named sources that backends can reference via `binary_source` in
# config.yaml. If this file doesn't exist, backends fall back to building
# from their Containerfile (current behavior).
#
# Uncomment and adjust the entries below for your hardware.

sources: {}

defaults:
  release_type: latest
  verify_checksum: true
  cache_ttl_hours: 24
