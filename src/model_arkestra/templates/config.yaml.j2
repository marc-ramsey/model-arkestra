# ═══════════════════════════════════════════
# config.yaml — ModelArkestra model configuration
# ═══════════════════════════════════════════
# This is the ONLY user-managed file.
#
# Backend definitions and engine arg schemas ship read-only inside the
# package. To change a backend setting, add a per-key OVERRIDE under
# backends: below — overrides deep-merge over the shipped definitions
# (override wins). Custom backends may be declared here as full sub-dicts.

default:
  admin-key: whatever          # key for /admin/* and /api/* auth
  admin-port: 9090             # admin dashboard port
  container-type: podman       # default container engine (podman or docker)
  ctx-size: 8192               # default context size, referenced as ${default/ctx-size}
  model-start-port: 18000      # first port in the auto-allocated range
  model-ports: 32              # number of ports available
  warmup-time: 10              # seconds after /health before a model is "running"
  app-log-lines: 2000          # global log ring buffer size

env:
  HF_HUB_CACHE: ~/.cache/huggingface

backends:
  default: vulkan-radv         # selects a backend from the shipped definitions

models:
  qwen3-4b:
    model: unsloth/Qwen3-4B-GGUF:Q4_K_M
    temp: 0.7
    top-p: 0.95
    top-k: 20
    ctx-size: ${default/ctx-size}
