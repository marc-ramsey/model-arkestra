# ═══════════════════════════════════════════
# config.yaml — ModelArkestra model configuration
# ═══════════════════════════════════════════
# For backend definitions (binary sources, download channels), see
# backends.yaml in the same directory.

models-start-port: 18000
model-ports: 32
warmup-time: 10

app-log-lines: 2000

env:
  HF_HUB_CACHE: ~/.cache/huggingface

container_type: podman   # default container engine (podman or docker)

backends:
  default: vulkan-radv   # references a backend name from backends.yaml

models:
  qwen3.8-27b:
    checkpoint: unsloth/Qwen3.8-27B-GGUF:Q4_K_M
    args:
      temp: 0.7
      top-p: 0.80
      top-k: 20
      presence-penalty: 1.5
      chat-template-kwargs: '{"reasoning_effort":"medium"}'

  qwen3.6-27b-mtp:
    checkpoint: unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q4_K_XL
    args:
      temp: 0.6
      top-p: 0.95
      top-k: 20
      chat-template-kwargs: '{"enable_thinking":true}'

  qwen3.6-35b-a3b:
    checkpoint: unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_XL
    args:
      temp: 0.6
      top-p: 0.95
      top-k: 20
      chat-template-kwargs: '{"enable_thinking":true}'

  gemma-4-12b-qat:
    checkpoint: unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
    args:
      temp: 1.0
      top-p: 0.95
      top-k: 64
      chat-template-kwargs: '{"enable_thinking":true}'

  gemma-4-26b-a4b-qat:
    checkpoint: unsloth/gemma-4-26B-A4B-it-qat-GGUF:UD-Q4_K_XL
    args:
      temp: 1.0
      top-p: 0.95
      top-k: 64
      chat-template-kwargs: '{"enable_thinking":true}'

  gemma-4-31b-qat:
    checkpoint: unsloth/gemma-4-31B-it-qat-GGUF:UD-Q4_K_XL
    args:
      temp: 1.0
      top-p: 0.95
      top-k: 64
      chat-template-kwargs: '{"enable_thinking":true}'
