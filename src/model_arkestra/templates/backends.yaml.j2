backends:
  vulkan-radv:
    description: "Vulkan with RADV driver \u2014 works on AMD, NVIDIA, and Intel GPUs"
    runner: ProcessModelRunner
    source_ref: official-vulkan-radv
    args:
      ngl: 999
      hf: ${CHECKPOINT}
      ctx-size: ${ctx-size}
  rocm:
    description: "ROCm \u2014 best for AMD iGPU and discrete GPUs"
    runner: ProcessModelRunner
    source_ref: rocm-gfx1151
    args:
      ngl: 999
      hf: ${CHECKPOINT}
      ctx-size: ${ctx-size}
  rocm-container:
    description: "ROCm container \u2014 kyuz0 toolbox with bundled ROCm libs"
    runner: container
    source_ref: amd-toolbox-rocm
    entrypoint: /usr/local/bin/llama-server
    devices:
    - /dev/kfd
    - /dev/dri
    args:
      hf: ${CHECKPOINT}
      ngl: 999
  cuda:
    description: "NVIDIA CUDA \u2014 for NVIDIA discrete GPUs"
    runner: ProcessModelRunner
    source_ref: official-cuda
    args:
      ngl: 999
      hf: ${CHECKPOINT}
      ctx-size: ${ctx-size}
  cpu:
    description: "CPU-only mode \u2014 uses all available cores"
    runner: ProcessModelRunner
    source_ref: ggml-org-cpu
    args:
      threads: ${nproc}
      hf: ${CHECKPOINT}
      no-mmap: true
sources:
  official-vulkan-radv:
    type: github-release
    repo: ggml-org/llama.cpp
    release_type: latest
    asset_pattern: llama-*-bin-*-vulkan-x64*
    sha256_asset: '*.sha256'
  rocm-gfx110X:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx110X-x64.zip
  rocm-gfx1150:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx1150-x64.zip
  rocm-gfx1151:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx1151-x64.zip
  rocm-gfx120X:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx120X-x64.zip
  rocm-gfx90a:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx90a-x64.zip
  rocm-gfx103X:
    type: github-release
    repo: lemonade-sdk/llamacpp-rocm
    release_type: latest
    asset_pattern: llama-*-ubuntu-rocm-gfx103X-x64.zip
  amd-toolbox-rocm:
    type: oci-image
    repo: docker.io/kyuz0/amd-strix-halo-toolboxes
    release_type: rocm-7.14
  official-cuda:
    type: github-release
    repo: ai-dock/llama.cpp-cuda
    release_type: latest
    asset_pattern: llama.cpp-*-cuda-*-amd64.tar.gz
  ggml-org-cpu:
    type: github-release
    repo: ggml-org/llama.cpp
    release_type: latest
    asset_pattern: llama-*-bin-*-static-x86_64*
    sha256_asset: ''
defaults:
  release_type: latest
  verify_checksum: true
  cache_ttl_hours: 24
