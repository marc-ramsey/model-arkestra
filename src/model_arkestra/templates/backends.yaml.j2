# ═══════════════════════════════════════════
# backends.yaml — Backend definitions & download sources
# ═══════════════════════════════════════════
# Auto-generated by model-arkestra init. Edit with caution if you know
# what you're doing. Use `model-arkestra add-backend` for custom local
# binaries instead of editing this file manually.

backends:

  # ── Built-in backends (generated by init) ────────────────────────

  vulkan-radv:
    description: "Vulkan with RADV driver — works on AMD, NVIDIA, and Intel GPUs"
    runner: ProcessModelRunner
    source_ref: official-vulkan-radv
    args:
      ngl: 999
      hf: "${CHECKPOINT}"
      ctx-size: ${ctx-size}

  rocm:
    description: "ROCm — best for AMD iGPU and discrete GPUs"
    runner: ProcessModelRunner
    source_ref: ggml-org-rocm
    args:
      ngl: 999
      hf: "${CHECKPOINT}"
      ctx-size: ${ctx-size}

  rocm-container:
    description: "ROCm container — kyuz0 toolbox with bundled ROCm libs"
    runner: podman
    source_ref: amd-toolbox-rocm
    entrypoint: /usr/local/bin/llama-server
    devices:
      - /dev/kfd
      - /dev/dri
    args:
      hf: "${CHECKPOINT}"
      ngl: 999

  cuda:
    description: "NVIDIA CUDA — for NVIDIA discrete GPUs"
    runner: ProcessModelRunner
    source_ref: runtime-nvidia
    args:
      ngl: 999
      hf: "${CHECKPOINT}"
      ctx-size: ${ctx-size}

  cpu:
    description: "CPU-only mode — uses all available cores"
    runner: ProcessModelRunner
    source_ref: ggml-org-cpu
    args:
      threads: ${nproc}
      hf: "${CHECKPOINT}"
      no-mmap: true


# ── Download sources (used by backends above) ─────────────────────

sources:

  official-vulkan-radv:
    type: github-release
    repo: ggml-org/llama.cpp
    release_type: latest
    asset_pattern: "llama-server-*-bin-*-vulkan*"
    sha256_asset: "*.sha256"

  # ROCm — uses system /opt/rocm/*/lib/*.so (SONAME stable across 7.x)
  # Compatible with ROCm 7.x systems including ROCm 7.2.4
  ggml-org-rocm:
    type: github-release
    repo: ggml-org/llama.cpp
    release_type: latest
    asset_pattern: "llama-server-*-bin-*-rocm-*-x64.tar.gz"
    sha256_asset: "*.sha256"

  # ROCm container image — kyuz0 toolbox with bundled ROCm libs, llama.cpp nightly
  amd-toolbox-rocm:
    type: oci-image
    repo: docker.io/kyuz0/amd-strix-halo-toolboxes
    release_type: rocm-7.14

  # CUDA process mode — validate nvidia-smi + libcuda, no download
  runtime-nvidia:
    type: runtime-check
    checks:
      - command: nvidia-smi
        exit_code: 0
      - path: /usr/lib/*/libcuda.so.1
      - path: /usr/lib/*/libcudart.so.*

  ggml-org-cpu:
    type: github-release
    repo: ggml-org/llama.cpp
    release_type: latest
    asset_pattern: "llama-server-*-bin-*-static*"
    sha256_asset: ""


defaults:
  release_type: latest
  verify_checksum: true
  cache_ttl_hours: 24
