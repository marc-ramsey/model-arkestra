#!/usr/bin/env python3
"""Arkestra Admin CLI.

Usage:
    arkestra-admin models -x http://localhost:8080
    arkestra-admin start qwen3-4b temp=0.7 --api-key secret
    arkestra-admin logs qwen3-4b --lines 50
"""
from __future__ import annotations
import os, sys

# Auto-activate venv if present in project tree
_venv = os.path.join(os.path.dirname(os.path.abspath(__file__)), "venv", "bin", "activate_this.py")
if os.path.isfile(_venv):
    exec(open(_venv).read(), {"__file__": _venv})  # noqa: S102

import sys

try:
    from aiohttp import ClientSession, ClientTimeout
except ImportError:
    print("Error: aiohttp required. Install with: pip install \"model-arkestra[proxy]\"", file=sys.stderr)
    sys.exit(1)

from model_arkestra.admin_cli import main

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
