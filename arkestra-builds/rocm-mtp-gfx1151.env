# rocm-mtp-gfx1151: ROCm gfx1151 build tracking PR #28243 (Qwen4Exp MTP draft head).
# MTP is a RUNTIME capability (--mtp flag), not a compile flag. This build only
# differs from rocm-gfx1151 by the source ref. Same binary works for both.
REPO="https://github.com/ggml-org/llama.cpp"
REF="pull/28243/head"
REQUIRES=(hipcc cmake git ninja)

CMAKE_ARGS=(
    -DGGML_HIP=ON
    -DAMDGPU_TARGETS=gfx1151
    -DLLAMA_CURL=ON
)

ENV_VARS=(
    "HSA_OVERRIDE_GFX_VERSION=11.5.1"
)
