# rocm-gfx1151: mainstream ROCm build for Strix Halo (Radeon 8060S).
# Source: ggml-org/llama.cpp master.
REPO="https://github.com/ggml-org/llama.cpp"
REF="master"
REQUIRES=(hipcc cmake git ninja)

CMAKE_ARGS=(
    -DGGML_HIP=ON
    -DAMDGPU_TARGETS=gfx1151
    -DLLAMA_CURL=ON
)

# Runtime/build env. HSA_OVERRIDE ensures the fat binary picks gfx1151 kernels
# even if rocminfo reports a variant; PYTORCH_ARCH is harmless future-proofing.
ENV_VARS=(
    "HSA_OVERRIDE_GFX_VERSION=11.5.1"
)
