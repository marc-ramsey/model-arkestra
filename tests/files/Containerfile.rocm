FROM docker.io/library/ubuntu:26.04

# Minimal ROCm runtime for AMD GPU support (glibc 2.43 matches host)
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl wget \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.4 noble main" > /etc/apt/sources.list.d/rocm.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        rocm-core hip-runtime-amd hipblas hipblaslt libgomp1 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LLAMA_CACHE=/home/lemonade/hub
ENV ROCBLAS_USE_HIPBLASLT=1
ENV GGML_CUDA_ENABLE_UNIFIED_MEMORY=ON
ENV LD_LIBRARY_PATH=/usr/local/bin:/opt/rocm/lib:/llm-server/bin

# The binary is mounted from host at runtime (e.g. /home/marc/local/llama.cpp/build-rocm/bin)
WORKDIR /root
VOLUME ["/models"]
EXPOSE 8080
ENTRYPOINT ["/llm-server/bin/llama-server"]
